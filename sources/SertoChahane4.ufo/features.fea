feature ccmp {

 script syrc;
     language dflt ;
      lookup ccmpGlyphCompositionDecompositioninSyriaclookup0;
} ccmp;

feature init {

 script syrc;
     language dflt ;
      lookup initInitialFormsinSyriaclookup1;
} init;

feature medi {

 script syrc;
     language dflt ;
      lookup mediMedialFormsinSyriaclookup2;
} medi;

feature med2 {

 script syrc;
     language dflt ;
      lookup med2MedialForms2inSyriaclookup3;
} med2;

feature fina {

 script syrc;
     language dflt ;
      lookup finaTerminalFormsinSyriaclookup4;
} fina;

feature fin2 {

 script syrc;
     language dflt ;
      lookup fin2TerminalForms2inSyriaclookup5;
} fin2;

feature fin3 {

 script syrc;
     language dflt ;
      lookup fin3TerminalForms3inSyriaclookup6;
} fin3;

feature liga {

 script syrc;
     language dflt ;
      lookup ligaStandardLigaturesinSyriaclookup7;
      lookup ligaStandardLigaturesinSyriaclookup8;
      lookup ligaStandardLigaturesinSyriaclookup9;
      lookup ligaStandardLigaturesinSyriaclookup10;
} liga;

feature dlig {

 script syrc;
     language dflt ;
      lookup dligDiscretionaryLigaturesinSyriaclookup11;
} dlig;

